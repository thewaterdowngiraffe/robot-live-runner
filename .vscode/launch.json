{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "Setup And Config Fresh Profile",
            "args": [
                "--profile",
                "ext_dev_RFLT",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensions-dir=${workspaceFolder}/.vscode-test/extensions"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ]
        }
    ]
}