{
  "name": "robot-live-runner",
  "displayName": "Robot Framework Live Testing Tool",
  "description": "Interactive REPL and live step execution for Robot Framework",
  "version": "1.0.0",
  "publisher": "thewaterdowngiraffe",

  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewaterdowngiraffe/robot-live-runner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:robotframework"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "robotLiveTest.runSelected",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && robotLiveTest.isActive"
      }
    ],
    "configuration": {
      "title": "Robot Live Runner",
      "properties": {
        "robotLiveTest.highlightColor": {
          "type": "string",
          "default": "rgba(100, 150, 255, 0.3)",
          "description": "Background color for currently executing lines (RGBA, HEX, or color name)."
        },
        "robotLiveTest.trailBaseColor": {
          "type": "string",
          "default": "76, 175, 80",
          "description": "RGB values for the gutter trail (e.g., '76, 175, 80' for green, '255, 0, 0' for red)."
        },
        "robotLiveTest.trailLength": {
          "type": "number",
          "default": 3,
          "description": "Number of previously executed lines to show in the fading gutter trail."
        },
        "robotLiveTest.additionalArgs": {
          "type": "string",
          "default": "",
          "description": "Custom arguments to pass to Robot Framework (e.g., '-v BROWSER:chrome')."
        },
        "robotLiveTest.useWorkspaceSettings": {
          "type": "boolean",
          "default": true,
          "description": "Automatically inject standard Robot Framework launch arguments from your workspace settings.json."
        }
      }
    },
    "commands": [
      {
        "command": "robotLiveTest.start",
        "title": "Start Live Session",
        "icon": "$(play-circle)"
      },
      {
        "command": "robotLiveTest.runTest",
        "title": "Run Full Test",
        "icon": "$(run-all)"
      },
      {
        "command": "robotLiveTest.runSelected",
        "title": "Run Selected Lines",
        "icon": "$(selection)"
      },
      {
        "command": "robotLiveTest.runBelow",
        "title": "Run Below",
        "icon": "$(arrow-down)"
      },
      {
        "command": "robotLiveTest.pause",
        "title": "Pause Execution",
        "icon": "$(debug-pause)"
      },
      {
        "command": "robotLiveTest.resume",
        "title": "Resume Execution",
        "icon": "$(debug-continue)"
      },
      {
        "command": "robotLiveTest.stopBatch",
        "title": "Stop Queue",
        "icon": "$(debug-stop)"
      },
      {
        "command": "robotLiveTest.stopSession",
        "title": "Stop Live Session",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "robotLiveTest.start",
          "when": "resourceExtname == .robot && !robotLiveTest.isActive",
          "group": "navigation@1"
        },
        {
          "command": "robotLiveTest.runTest",
          "when": "robotLiveTest.isActive && !robotLiveTest.isExecuting && !robotLiveTest.isPaused",
          "group": "navigation@2"
        },
        {
          "command": "robotLiveTest.runSelected",
          "when": "robotLiveTest.isActive && !robotLiveTest.isExecuting && !robotLiveTest.isPaused",
          "group": "navigation@3"
        },
        {
          "command": "robotLiveTest.runBelow",
          "when": "robotLiveTest.isActive && !robotLiveTest.isExecuting && !robotLiveTest.isPaused",
          "group": "navigation@4"
        },
        {
          "command": "robotLiveTest.pause",
          "when": "robotLiveTest.isActive && robotLiveTest.isExecuting && !robotLiveTest.isPaused",
          "group": "navigation@5"
        },
        {
          "command": "robotLiveTest.resume",
          "when": "robotLiveTest.isActive && robotLiveTest.isPaused",
          "group": "navigation@5"
        },
        {
          "command": "robotLiveTest.stopBatch",
          "when": "robotLiveTest.isActive && (robotLiveTest.isExecuting || robotLiveTest.isPaused)",
          "group": "navigation@6"
        },
        {
          "command": "robotLiveTest.stopSession",
          "when": "robotLiveTest.isActive",
          "group": "navigation@7"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
