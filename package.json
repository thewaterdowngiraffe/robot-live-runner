{
  "name": "robot-live-runner",
  "displayName": "Robot Framework Live Testing Tool",
  "description": "Interactive REPL and live step execution for Robot Framework",
  "version": "1.1.1",
  "publisher": "thewaterdowngiraffe",
  "bugs": {"url": "https://github.com/thewaterdowngiraffe/robot-live-runner/issues"},
  "homepage": "https://github.com/thewaterdowngiraffe/robot-live-runner",
  "extensionDependencies": [
    "d-biehl.robotcode"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewaterdowngiraffe/robot-live-runner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "Live Test",
    "Robot Framework Tools",
    "Live Runner",
    "Robot Framework Testing",
    "REPL"
  ],
  "categories": [
    "Testing",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:robotframework"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "robotLiveTest.runSelected",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && robotLiveTest.isActive"
      }
    ],
    "configuration": {
      "title": "Robot Live Runner",
      "properties": {
        "robotLiveTest.highlightColor": {
          "type": "string",
          "default": "rgba(100, 150, 255, 0.3)",
          "description": "Background color for currently executing lines (RGBA, HEX, or color name)."
        },
        "robotLiveTest.trailBaseColor": {
          "type": "string",
          "default": "76, 175, 80",
          "description": "RGB values for the gutter trail (e.g., '76, 175, 80' for green, '255, 0, 0' for red)."
        },
        "robotLiveTest.trailLength": {
          "type": "number",
          "default": 3,
          "description": "Number of previously executed lines to show in the fading gutter trail."
        },
        "robotLiveTest.additionalArgs": {
          "type": "string",
          "default": "",
          "description": "Custom arguments to pass to Robot Framework (e.g., '-v BROWSER:chrome')."
        },
        "robotLiveTest.useWorkspaceSettings": {
          "type": "boolean",
          "default": true,
          "description": "Automatically inject standard Robot Framework launch arguments from your workspace settings.json."
        }
      }
    },
    "commands": [
      {
        "command": "robotLiveTest.StartLiveTest",
        "title": "Start Live Test",
        "icon": "$(play-circle)"
      },
      {
        "command": "robotLiveTest.StopLiveTest",
        "title": "Stop Live Test",
        "icon": "$(stop)"
      },
      {
        "command": "robotLiveTest.runSelected",
        "title": "Run Selected",
        "icon": "$(selection)"
      },
      {
        "command": "robotLiveTest.RunBelow",
        "title": "Run Below",
        "icon": "$(arrow-down)"
      },
      {
        "command": "robotLiveTest.RunFullTest",
        "title": "Run Full Test",
        "icon": "$(testing-run-all-icon)"
      },
      {
        "command": "robotLiveTest.PauseExecution",
        "title": "Pause Execution",
        "icon": "$(debug-pause)"
      },
      {
        "command": "robotLiveTest.ResumeExecution",
        "title": "Resume Execution",
        "icon": "$(debug-continue)"
      },
      {
        "command": "robotLiveTest.StopCurrentQueue",
        "title": "Stop Current Queue",
        "icon": "$(clear-all)"
      },
      {
        "command": "robotLiveTest.reimport",
        "title": "Re-import",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "robot-live-test-panel",
          "title": "Robot Live Test",
          "icon": "$(play)"
        }
      ]
    },
    "views": {
      "robot-live-test-panel": [
        {
          "id": "robotLiveTest.controlsView",
          "name": "Execution Controls"
        },
        {
          "id": "robotLiveTest.historyView",
          "name": "Recent Executions"
        },
        {
          "id": "robotLiveTest.ImportsView",
          "name": "Imported Libraries"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "robotLiveTest.reimport",
          "when": "view == robotLiveTest.ImportsView && viewItem == file",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "robotLiveTest.StartLiveTest",
          "when": "resourceExtname == .robot && !robotLiveTest.isActive",
          "group": "navigation@1"
        },
        {
          "command": "robotLiveTest.StopLiveTest",
          "when": "robotLiveTest.isActive",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "prepare": "npm run compile",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "python -m pytest && vscode-test"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/sinon": "^22.0.2",
    "@types/vscode": "^1.85.x",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "chai": "^4.5.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "typescript": "^6.0.x",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "minimatch": "^11.0.1"
  }
}
